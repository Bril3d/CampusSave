# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Clé secrète pour signer les jetons d'authentification du serveur local
AUTH_SECRET="change_this_secret_in_production"

# KONNECT SANDBOX (https://docs.konnect.network/)
KONNECT_BASE_URL="https://api.sandbox.konnect.network/api/v2"
KONNECT_API_KEY="MY_KONNECT_SANDBOX_API_KEY"
KONNECT_RECEIVER_WALLET_ID="MY_KONNECT_WALLET_ID"

# FIREBASE ADMIN SDK (chemin vers le fichier serviceAccountKey.json local)
FIREBASE_SERVICE_ACCOUNT_PATH="./backend/serviceAccountKey.json"
